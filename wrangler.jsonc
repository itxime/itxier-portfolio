{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "itxier-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "routes": [
    { "pattern": "itxiermeziani.com", "custom_domain": true },
    { "pattern": "www.itxiermeziani.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "itxier-portfolio"
    }
  ],
  "observability": {
    "enabled": true
  }
}
